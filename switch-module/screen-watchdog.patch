+
+void ProtoScreenIdle(bool idle)
+{
+	mutexLock(&screenMutex);
+	if (screenStateModified && idle != screenSuspended)
+	{
+		// idle: the screen is switched on, otherwise off again
+		if (UtilSetConsoleScreenMode(idle))
+			screenSuspended = idle;
+	}
+	mutexUnlock(&screenMutex);
 }
 
