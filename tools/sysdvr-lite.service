[Unit]
Description=SysDVR lite client (Switch over USB -> HDMI)
After=systemd-udevd.service sound.target
Wants=sound.target

[Service]
ExecStart=/usr/local/bin/sysdvr-lite --usb --decoder v4l2 --drm --audio-device plughw:CARD=HDMI,DEV=0
Restart=always
RestartSec=2
# a real-time-ish feel: keep the decode thread from being starved
Nice=-5

[Install]
WantedBy=multi-user.target
